msgstr "BTC/M1 · هوية Operator إلزامية"

msgid "Liquidity Providers"
msgstr "مزوّدو السيولة"

msgid "X/M1 · Operator identity optional"
msgstr "X/M1 · هوية Operator اختيارية"

msgid "Builders"
msgstr "المطوّرون"

msgid "Compose applications"
